# ============================================================================
# DUMMYTICKET — FLIGHT BOOKING & CONFIRMED ITINERARY PLATFORM
# Copy this file to .env.local and fill in your credentials.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or RAZORPAY_KEY_SECRET with NEXT_PUBLIC_
# ============================================================================

# Application Public URL & Brand Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="DummyTicket"
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway (Server-Side Only for Secrets)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_server_only
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_server_only

# Transactional Email Provider (Resend)
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM="DummyTicket <bookings@dummyticket.example.com>"
SUPPORT_EMAIL="support@dummyticket.example.com"

# Scheduled Job Secret
CRON_SECRET=your_scheduled_job_secret_token
